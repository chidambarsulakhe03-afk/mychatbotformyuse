# ==========================================
# Frontend Configuration (.env)
# ==========================================

# Supabase Project Credentials (Found in Supabase Dashboard -> Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional: Direct Groq API key for local development testing only
# NOTE: In production, the Groq API key is kept securely inside Supabase Edge Function Secrets!
# VITE_GROQ_API_KEY=gsk_your_groq_api_key_here

# Optional: Default Groq Model
# Options: llama-3.3-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768
VITE_DEFAULT_MODEL=llama-3.3-70b-versatile
